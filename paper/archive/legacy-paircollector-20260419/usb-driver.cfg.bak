{
    "target": "linux/amd64",
    "http": "127.0.0.1:56979",
    "workdir": "/home/zzzccc/BASS/DDRD-syzkaller/test/DDRD-PairCollector/test/workdir-usb-corpus",
    "kernel_obj": "/home/zzzccc/Linux-Kernel/DDRD-Kernel",
    "image": "/home/zzzccc/BASS/DDRD-syzkaller/test/fs/bookworm.img",
    "sshkey": "/home/zzzccc/BASS/DDRD-syzkaller/test/fs/bookworm.id_rsa",
    "syzkaller": "/home/zzzccc/BASS/DDRD-syzkaller/",
    "procs": 2,
    "type": "qemu",
    "reproduce": false,
    "vm_running_time": 300,
    "cover": true,
    "sandbox": "none",
    "vmlinux": "/home/zzzccc/Linux-Kernel/DDRD-Kernel/vmlinux-usb",
    "enable_syscalls": [
        "syz_open_dev$usbmon",
        "read$usbmon",
        "mmap$usbmon",
        "ioctl$MON_IOCQ_URB_LEN",
        "ioctl$MON_IOCQ_RING_SIZE",
        "ioctl$MON_IOCT_RING_SIZE",
        "ioctl$MON_IOCH_MFLUSH",
        "ioctl$MON_IOCX_GET",
        "ioctl$MON_IOCX_GETX",
        "ioctl$MON_IOCX_MFETCH",
        "ioctl$MON_IOCG_STATS",
        "syz_open_dev$usbfs",
        "read$usbfs",
        "mmap$usbfs",
        "ioctl$USBDEVFS_REAPURB",
        "ioctl$USBDEVFS_REAPURBNDELAY",
        "ioctl$USBDEVFS_CONTROL",
        "ioctl$USBDEVFS_BULK",
        "ioctl$USBDEVFS_RESETEP",
        "ioctl$USBDEVFS_RESET",
        "ioctl$USBDEVFS_CLEAR_HALT",
        "ioctl$USBDEVFS_GETDRIVER",
        "ioctl$USBDEVFS_CONNECTINFO",
        "ioctl$USBDEVFS_SETINTERFACE",
        "ioctl$USBDEVFS_SUBMITURB",
        "ioctl$USBDEVFS_SETCONFIGURATION",
        "ioctl$USBDEVFS_DISCARDURB",
        "ioctl$USBDEVFS_DISCSIGNAL",
        "ioctl$USBDEVFS_CLAIMINTERFACE",
        "ioctl$USBDEVFS_RELEASEINTERFACE",
        "ioctl$USBDEVFS_IOCTL",
        "ioctl$USBDEVFS_CLAIM_PORT",
        "ioctl$USBDEVFS_GET_CAPABILITIES",
        "ioctl$USBDEVFS_DISCONNECT_CLAIM",
        "ioctl$USBDEVFS_FREE_STREAMS",
        "ioctl$USBDEVFS_DROP_PRIVILEGES",
        "ioctl$USBDEVFS_GET_SPEED",
        "ioctl$USBDEVFS_FORBID_SUSPEND",
        "ioctl$USBDEVFS_ALLOW_SUSPEND",
        "ioctl$USBDEVFS_WAIT_FOR_RESUME",
        "open$kccwf",
        "read$kccwf",
        "write$kccwf",
        "close$kccwf",
        "fchmod$kccwf",
        "truncate$kccwf",
        "fallocate$kccwf",
        "link$kccwf",
        "unlink$kccwf",
        "setxattr$kccwf",
        "fsetxattr$kccwf",
        "fsync$kccwf"
    ],
    "vm": {
        "count": 4,
        "kernel": "/home/zzzccc/Linux-Kernel/DDRD-Kernel/arch/x86/boot/bzImage-usb",
        "cpu": 2,
        "cmdline": "",
        "qemu_args": "-enable-kvm -drive if=none,id=my-usb-drive,file=/home/zzzccc/BASS/DDRD-syzkaller/test/DDRD/usb.img,format=raw -device qemu-xhci,id=xhci -device usb-storage,bus=xhci.0,drive=my-usb-drive",
        "mem": 4096
    },
    "experimental": {
        "skip_duplicate_data_races": true,
        "barrier_mode": true,
        "barrier_procs": [
            0,
            1
        ],
        "uaf_mode": true,
        "uaf_validate": {
            "max_concurrent": 4,
            "delay_retry_budget": 2,
            "timeout_seconds": 120,
            "repeat_count": 4,
            "executor_program_timeout_seconds": 300,
            "executor_syscall_timeout_millis": 20000
        },
        "ddrd_monitor": false
    }
}
